# Copy to .env.local and fill in. Never commit real values.

# Neon / Postgres connection string
DATABASE_URL=

# Admin login. ADMIN_SESSION_SECRET is optional; sessions are signed with ADMIN_PASSWORD if it's empty.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Image uploads (ImgBB) and contact emails (Brevo)
IMGBB_API_KEY=
BREVO_API_KEY=
ADMIN_EMAIL=

# Optional: raises GitHub's API limit from 60 to 5,000 requests/hour (stars, forks, repo import).
# A fine-grained token with no extra permissions is enough for public repos.
GITHUB_TOKEN=

# Public site URL used for share previews, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://utkristi.com

# Google Analytics measurement ID (G-...). Leave empty to disable Analytics.
NEXT_PUBLIC_GA_ID=

# Optional: error monitoring with Sentry (stays off while empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: two-factor code for the admin login. Generate with `npm run admin:2fa`.
ADMIN_TOTP_SECRET=
